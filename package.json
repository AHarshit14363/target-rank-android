
{
  "name": "target-rank-android",
  "version": "1.0.0",
  "private": true,
  "description": "TARGET RANK OFFICIAL Android app",
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.mkdirSync('www/assets',{recursive:true});for(const f of fs.readdirSync('.'))if(/\\.(html|css|js|webmanifest|xml|txt)$/.test(f)&&fs.statSync(f).isFile())fs.copyFileSync(f,'www/'+f);if(fs.existsSync('assets'))fs.cpSync('assets','www/assets',{recursive:true});console.log('Website files prepared')"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
